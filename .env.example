# =======================================================
#  🌍 ExploreX - Environment Configuration Template
# =======================================================

# --- Core Server Configuration ---
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# --- Frontend API Target (Optional, for separate frontend/backend deployments) ---
# VITE_API_URL=http://localhost:3000

# --- Supabase (Database & Authentication) ---
# Get from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI Intelligence Engines ---
# OpenAI GPT-4o for Assistant, Smart Itineraries & Trip Autopilot
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Google Gemini (Alternative / Fallback AI Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Payment Gateway (Razorpay) ---
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Transactional Communications (Resend) ---
# Get from Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=confirmations@explorex.com

# --- Maps & Geospatial Services (Optional) ---
# Google Maps / Places API key (falls back to Leaflet + OpenStreetMap)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- ML Microservice (Optional companion service) ---
ML_SERVICE_URL=http://localhost:8000